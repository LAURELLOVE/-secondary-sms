# Copy this file to .env and fill in your own values.
# Leave every SMS_* / NEXAH_* / TWILIO_* value blank to use the mock SMS provider
# (the OTP is logged to the server console and shown on-screen instead of texted).
#
# If both Nexah and Twilio are configured, Nexah is used (better local Cameroon rates).

PORT=4000
JWT_SECRET=change-this-to-a-long-random-string

# MongoDB Atlas (https://mongodb.com/atlas) - free forever tier, no credit card needed.
# Get this from Atlas: Database > Connect > Drivers > copy the connection string,
# then replace <password> with your database user's password.
MONGODB_URI=
MONGODB_DB_NAME=secondary_sms

# Nexah BulkSMS (https://smsvas.com) - covers MTN Cameroon and Orange Cameroon
NEXAH_USER=
NEXAH_PASSWORD=
NEXAH_SENDER_ID=

# Twilio (https://twilio.com) - instant self-service signup, works globally
# Find TWILIO_ACCOUNT_SID and TWILIO_AUTH_TOKEN on your Twilio Console home page.
# TWILIO_FROM_NUMBER is the Twilio phone number assigned to your account (with country code, e.g. +15017122661).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
