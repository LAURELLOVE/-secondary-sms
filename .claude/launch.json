{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "server",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "server"
      ],
      "port": 4000
    },
    {
      "name": "client",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "client"
      ],
      "port": 5173
    },
    {
      "name": "client-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "preview",
        "--prefix",
        "client",
        "--",
        "--port",
        "4173",
        "--host"
      ],
      "port": 4173
    },
    {
      "name": "client-admin",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:admin",
        "--prefix",
        "client"
      ],
      "port": 5174
    },
    {
      "name": "client-teacher",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:teacher",
        "--prefix",
        "client"
      ],
      "port": 5175
    }
  ]
}